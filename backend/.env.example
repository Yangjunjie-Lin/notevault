# Backend environment example for local development and Vercel Production.
# Copy values into a local .env or Vercel Project settings. Do not commit secrets.

ENVIRONMENT=development
APP_NAME=NoteVault API
APP_VERSION=1.0.0

# Comma-separated browser origins allowed by CORS.
# Local development:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (set the real frontend origin after the frontend Vercel Project is live):
# ENVIRONMENT=production
# ALLOWED_ORIGINS=https://notevault-lovat.vercel.app

# Local credential file (ignored by Git):
FIREBASE_CREDENTIALS_PATH=backend/serviceAccountKey.json

# Production credential (Vercel Environment Variable, single-line JSON):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id"}

PORT=8000
