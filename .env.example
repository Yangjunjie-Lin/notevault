# Frontend (Vite / Vercel)
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Backend (FastAPI / Vercel)
# development (default) keeps local origins usable without extra config.
ENVIRONMENT=development
APP_NAME=NoteVault API
APP_VERSION=1.1.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIREBASE_CREDENTIALS_PATH=backend/serviceAccountKey.json
CURSOR_SIGNING_KEY=notevault-local-development-cursor-key

# Production example (set these in the Vercel Project environment, never commit real values):
# ENVIRONMENT=production
# ALLOWED_ORIGINS=https://notevault-lovat.vercel.app
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id"}
# CURSOR_SIGNING_KEY=generate-a-random-secret-with-at-least-32-characters
# VITE_API_BASE_URL=https://notevault-api.vercel.app
