# Frontend environment example for local development and Vercel Production.
# Vite reads these from the repository root `.env` during local development
# (`envDir: '..'` in vite.config.js). On Vercel, set them in the frontend Project.

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000
# Production example:
# VITE_API_BASE_URL=https://notevault-api.vercel.app

# Firebase Web App config (safe to expose in the browser)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
