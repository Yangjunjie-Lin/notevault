{
  "name": "notevault-frontend",
  "private": true,
  "version": "1.1.0",
  "description": "Production React and TypeScript frontend for NoteVault.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview --port 4173",
    "preview:e2e": "vite preview --mode e2e --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:production-auth-gate": "node scripts/assert-production-auth-gate.mjs",
    "contract:generate": "openapi-typescript ../backend/openapi.json -o src/features/notes/generated.ts",
    "check": "npm run typecheck && npm test && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.9"
  }
}
